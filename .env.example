# iCare Navigator Environment Configuration
# Copy this file to .env to configure custom settings

# (Optional) Gemini API Key for LLM Synthesis
# If left empty, iCare uses high-precision deterministic offline synthesis
GEMINI_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1
CONFIDENCE_THRESHOLD=0.85
SESSION_TTL_SECONDS=1800

# (Future Track 2) LINE Messaging API Configuration
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
